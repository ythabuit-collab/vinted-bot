seen_ids = set()

def scan_all():
    found = 0
    for brand_name, brand_data in BRANDS.items():
        for keyword in brand_data["keywords"]:
            items = search_vinted(keyword, max_price=BUDGET_MAX)
            for item in items:
                item_id = item.get("id")
                if not item_id or item_id in seen_ids:
                    continue
                seen_ids.add(item_id)

                result = evaluate_item(item, brand_name, brand_data)
                if not result:
                    continue

                photos    = item.get("photos", [])
                photo_url = None
                if photos:
                    photo_url = photos[0].get("url") or photos[0].get("full_size_url")

                msg = format_alert(item, result)
                send_telegram(msg, photo_url=photo_url)

                print(
                    f"[{datetime.now().strftime('%H:%M:%S')}] "
                    f"ð¥ {result['brand_name']} | "
                    f"{item.get('title','?')[:40]} | "
                    f"{result['price']}â¬ â ~{result['resell_value']:.0f}â¬ "
                    f"(x{result['ratio']}) | +{result['net_gain']:.0f}â¬ net"
                )
                found += 1
                time.sleep(1)

            time.sleep(2)
    return found

